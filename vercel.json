{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://invoiceguard-backend-8egf.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://invoiceguard-backend-8egf.onrender.com/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
